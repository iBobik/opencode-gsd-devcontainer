{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@howaboua/opencode-usage-plugin"
  ],
  "provider": {
    "ppq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PayPerQ - ppq.ai",
      "options": {
        "baseURL": "https://api.ppq.ai",
        "includeUsage": true
      }
    }
  },
  "permission": {
    "edit": {
      "/tmp/*": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/agents/*": "allow"
    },
    "read": {
      "~/.config/opencode/agents/*": "allow"
    }
  }
}
