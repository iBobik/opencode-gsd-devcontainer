{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "docker build -t opencode-gsd-devcontainer:local .", "effect": "allow" },
    { "action": "shell", "resource": "docker build -f opencode-ppq-plugin/test/Dockerfile opencode-ppq-plugin", "effect": "allow" },
    { "action": "shell", "resource": "docker build -f opencode-council-plugin/test/Dockerfile opencode-council-plugin", "effect": "allow" },
    { "action": "shell", "resource": "docker build --network=none --no-cache --progress=plain -f /workspace/.tmp-analysis/Dockerfile /workspace/.tmp-analysis", "effect": "allow" },
    { "action": "shell", "resource": "git --no-optional-locks -c core.fsmonitor=false status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv --stat", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv --check", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv --cached", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv --cached --stat", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff --no-ext-diff --no-textconv --cached --check", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager log --oneline -10", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": ".devcontainer/*", "effect": "ask" },
    { "action": "edit", "resource": "/workspace/.devcontainer/*", "effect": "ask" }
  ],
  "experimental": { "subagent_depth": 2 },
  "plugins": [
    "@slkiser/opencode-quota",
    "/workspace/opencode-ppq-plugin",
    "/workspace/opencode-council-plugin"
  ]
}
