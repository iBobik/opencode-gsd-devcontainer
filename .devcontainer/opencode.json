{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "docker build *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow"
    },
    "external_directory": "deny"
  },
  "plugin": [
    "/workspace/opencode-ppq-plugin/plugin/opencode-ppq.ts",
    "/workspace/opencode-council-plugin/plugin/opencode-council.ts"
  ],
  "provider": {
    "ppq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PayPerQ - ppq.ai",
      "options": {
        "baseURL": "https://api.ppq.ai",
        "includeUsage": true
      }
    },
  }
}
